+	if (on) {
+		rc = pm8xxx_aux_clk_control(CLK_MP3_2, XO_DIV_1, true);
+		if (rc) {
+			pr_err("%s: unable to write aux clock register(%d)\n",
+				__func__, rc);
+			goto err_gpio_dis;
+		}
+	} else {
+		rc = pm8xxx_aux_clk_control(CLK_MP3_2, XO_DIV_NONE, true);
+		if (rc)
+			pr_err("%s: unable to write aux clock register(%d)\n",
+				__func__, rc);
+	}
+
+	return rc;
+
+err_gpio_dis:
+	gpio_set_value_cansleep(gpio, !on);
+	return rc;
+}
