+static int isa1200_clk_enable(bool on)
+{
+	unsigned int gpio = ISA1200_HAP_CLK_PM8921;
+	int rc = 0;
+
+	if (socinfo_get_pmic_model() == PMIC_MODEL_PM8917)
+		gpio = ISA1200_HAP_CLK_PM8917;
